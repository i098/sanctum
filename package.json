{
  "name": "sanctum-handoff",
  "private": true,
  "type": "module",
  "description": "Sanctum application workspaces and handoff documentation tools",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && node scripts/handoff.ts check",
    "docs:render": "node scripts/handoff.ts render",
    "docs:build": "node scripts/handoff.ts build",
    "quality:fallow": "fallow audit --gate new-only",
    "quality:sentrux": "sentrux gate .",
    "commitlint": "commitlint",
    "check:app": "node scripts/check-app.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@effect/vitest": "0.30.0",
    "@types/node": "24.19.0",
    "fallow": "3.30.0",
    "fast-xml-parser": "5.11.1",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  },
  "workspaces": [
    "packages/contracts",
    "server",
    "web-app",
    "sdk/typescript"
  ]
}
