// Deploy from this directory: `npx wrangler deploy` (docs/operations.md, "Cloudflare").
// MySQL host/user/password/CA, R2 endpoint/keys, WORKERS_AI_API_TOKEN, provider keys, SANCTUM_OIDC_CLIENT_SECRET and the login tokens are Worker secrets.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sanctum",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "sanctum.42nights.dev", "custom_domain": true }],
  // Invocation logs would store the request URL, and /__login/<LOGIN_TOKEN> is a secret.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Restarts the job worker after a crash or rollout; a running worker is left alone unless its start settings changed (docs/operations.md, "Cloudflare").
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Production refuses to start until the open decisions in docs/DECISIONS.md are selected.
    "SANCTUM_ENV": "development",
    // Free hosted tier: owner, admin and member seats per workspace; `workspaces.seat_limit` overrides it (docs/DECISIONS.md).
    "SANCTUM_DEFAULT_SEAT_LIMIT": "5",
    // Sign-in and the MCP authorization server: WorkOS AuthKit, production environment (docs/operations.md, "Cloudflare").
    "SANCTUM_SELECTED_DECISIONS": "identity_issuer,mcp_authorization_server",
    "SANCTUM_OIDC_ISSUER": "https://merry-precipice-00.authkit.app",
    "SANCTUM_OIDC_CLIENT_ID": "client_01M4F52XRNYW3H8YQBF1NRGQCE",
    "SANCTUM_OIDC_REDIRECT_URI": "https://sanctum.42nights.dev/auth/callback",
    "SANCTUM_MCP_ISSUER": "https://merry-precipice-00.authkit.app",
    "SANCTUM_MCP_JWKS_URL": "https://merry-precipice-00.authkit.app/oauth2/jwks",
    "SANCTUM_MCP_RESOURCE": "https://sanctum.42nights.dev/mcp",
    // WorkOS DCR and CIMD clients get only OIDC scopes; these apply to such tokens, narrowed by role.
    "SANCTUM_MCP_DEFAULT_SCOPES": "context:read,context:write,recordings:read",
    "MYSQL_DATABASE": "sanctum",
    // API and worker pools together stay well under the managed server's connection limit.
    "MYSQL_POOL_SIZE": "8",
    "R2_BUCKET": "sanctum-recordings",
    // Workers AI runs speech-to-text and the voice and extraction models on this account (docs/operations.md).
    "WORKERS_AI_ACCOUNT_ID": "2c040ec5bc2efe34e60ab5b1b4fd2e99"
  },
  "containers": [
    { "class_name": "SanctumApi", "image": "../../server/Dockerfile", "image_build_context": "../..", "instance_type": "basic", "max_instances": 1 },
    { "class_name": "SanctumJobs", "image": "../../server/Dockerfile", "image_build_context": "../..", "instance_type": "basic", "max_instances": 1 }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "SanctumApi" },
      { "name": "JOBS", "class_name": "SanctumJobs" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SanctumApi", "SanctumJobs"] }]
}
